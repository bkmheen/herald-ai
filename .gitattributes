# herald-ai 는 bash/POSIX 스크립트로 동작한다.
# Windows 에서 clone 해도 셸 스크립트가 CRLF 로 변환되면 실행이 깨지므로
# (예: `set -euo pipefail\r` → "invalid option name") 항상 LF 로 강제한다.

# 셸 스크립트 및 훅 설정: 무조건 LF
*.sh        text eol=lf
*.bash      text eol=lf

# 커맨드/설정/문서: LF 로 정규화
*.json      text eol=lf
*.md        text eol=lf
*.conf      text eol=lf
*.example   text eol=lf
VERSION     text eol=lf
LICENSE     text eol=lf

# 그 외 텍스트는 git 이 자동 판별
*           text=auto
